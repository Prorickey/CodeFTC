{
  "name": "code-ftc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/generate-ftc-completions.mjs && next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r content .next/standalone/content",
    "generate:completions": "node scripts/generate-ftc-completions.mjs",
    "start": "node .next/standalone/server.js",
    "test": "bun test tests/",
    "test:e2e": "playwright test e2e/",
    "lint": "eslint .",
    "setup:ftc-template": "node scripts/download-ftc-template.mjs",
    "build:cheerpj": "bash scripts/build-cheerpj-assets.sh",
    "docker:build": "docker compose build nextjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f nextjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:studio": "bun prisma studio",
    "db:migrate": "bun prisma migrate dev",
    "db:generate": "bun prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "^16.1.6",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tailwindcss/postcss": "^4.2.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.576.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.19.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.7.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/jszip": "^3.4.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "prisma": "^7.4.2",
    "typescript": "^5.9.3"
  }
}
